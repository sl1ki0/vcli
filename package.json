{
  "name": "vcli-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "build": "bun run scripts/build.ts",
    "benchmark": "bun run scripts/benchmark.ts",
    "smoke": "bun run scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.3.13",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "overrides": {
    "seroval": "1.6.3"
  }
}
