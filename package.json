{
  "name": "vcli-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/index.ts",
    "test": "bun test",
    "test:homework": "bun test tests/homework-*.test.ts packages/core/tests/managed-run.test.ts",
    "check": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "benchmark": "bun run scripts/benchmark.ts",
    "smoke": "bun run scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.3.13",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
